# PayPal SANDBOX REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# Keyring refuses to run against anything but the sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PORT=3001

# Google Gemini (AI explanations + follow-up Q&A). Optional: without it Keyring uses the labeled template fallback.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_MS=8000
